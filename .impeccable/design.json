  "components": [
    {
      "name": "Default Button",
      "kind": "button",
      "refersTo": "button",
      "description": "Bordered surface button for most actions.",
      "html": "<button class=\"ds-btn\">Practice problem keys</button>",
      "css": ".ds-btn{font-family:var(--body);display:inline-flex;align-items:center;gap:8px;border:1px solid var(--line);background:var(--surface);color:var(--ink);border-radius:8px;padding:8px 16px;font-weight:700;font-size:15px;cursor:pointer}.ds-btn:hover{border-color:var(--accent)}.ds-btn:focus-visible{outline:2px solid var(--accent);outline-offset:2px}"
    },
    {
      "name": "Go Button",
      "kind": "button",
      "refersTo": "button-go",
      "description": "Amber call to start or continue the next lesson; one per screen.",
      "html": "<button class=\"ds-btn-go\"><span class=\"ds-tri\"></span>Start lesson</button>",
      "css": ".ds-btn-go{font-family:var(--body);display:inline-flex;align-items:center;gap:8px;border:1px solid var(--go);background:var(--go);color:var(--go-ink);border-radius:8px;padding:8px 16px;font-weight:700;font-size:15px;cursor:pointer}.ds-btn-go:hover{filter:brightness(1.05)}.ds-btn-go:focus-visible{outline:2px solid var(--accent);outline-offset:2px}.ds-tri{width:0;height:0;border-left:8px solid currentColor;border-top:5px solid transparent;border-bottom:5px solid transparent}"
    },
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Keycap Blue confirm action.",
      "html": "<button class=\"ds-btn-primary\">Use this layout</button>",
      "css": ".ds-btn-primary{font-family:var(--body);display:inline-flex;align-items:center;gap:8px;border:1px solid var(--accent);background:var(--accent);color:var(--accent-ink);border-radius:8px;padding:8px 16px;font-weight:700;font-size:15px;cursor:pointer}.ds-btn-primary:hover{filter:brightness(1.08)}.ds-btn-primary:focus-visible{outline:2px solid var(--accent);outline-offset:2px}"
    },
    {
      "name": "Text Input",
      "kind": "input",
      "refersTo": "input",
      "description": "Field with bold label and muted help.",
      "html": "<label class=\"ds-field\"><span>Daily goal (minutes)</span><input class=\"ds-input\" type=\"number\" value=\"15\"><small>Short daily sessions beat long ones.</small></label>",
      "css": ".ds-field{font-family:var(--body);display:flex;flex-direction:column;gap:6px;color:var(--ink)}.ds-field span{font-weight:700;font-size:14px}.ds-field small{color:var(--muted);font-size:13px}.ds-input{font:inherit;color:var(--ink);background:var(--surface-2);border:1px solid var(--line);border-radius:8px;padding:8px 10px;width:100%}.ds-input:focus-visible{outline:2px solid var(--accent);outline-offset:2px}"
    },
    {
      "name": "Sidebar Nav",
      "kind": "nav",
      "refersTo": "nav-item",
      "description": "Vertical nav with number-key shortcuts; active row is solid blue.",
      "html": "<nav class=\"ds-nav\"><button class=\"on\">Lessons<span>1</span></button><button>Practice<span>2</span></button><button>Layout<span>3</span></button><button>Settings<span>4</span></button></nav>",
      "css": ".ds-nav{font-family:var(--body);display:flex;flex-direction:column;gap:4px;width:250px}.ds-nav button{font:inherit;display:flex;justify-content:space-between;align-items:center;border:0;background:transparent;color:var(--ink);padding:10px 12px;border-radius:8px;font-weight:700;cursor:pointer}.ds-nav button:hover{background:var(--surface)}.ds-nav button.on{background:var(--accent);color:var(--accent-ink)}.ds-nav button span{font-family:var(--mono);font-weight:400;font-size:12px;opacity:.55}.ds-nav button:focus-visible{outline:2px solid var(--accent);outline-offset:2px}"
    },
    {
      "name": "Keycap Chip",
      "kind": "chip",
      "refersTo": "keycap-chip",
      "description": "Inline key legend with a raised 3px bottom edge.",
      "html": "<span class=\"ds-kc\">a</span> <span class=\"ds-kc\">⇧</span> <span class=\"ds-kc ds-big\">r</span> <span class=\"ds-kc ds-warn\">;</span>",
      "css": ".ds-kc{display:inline-flex;align-items:center;justify-content:center;min-width:1.9em;height:1.9em;padding:0 .4em;border:1px solid var(--key-edge);border-bottom-width:3px;border-radius:6px;background:var(--key);color:var(--key-ink);font-family:var(--mono);font-weight:600;font-size:.86em;line-height:1}.ds-big{font-size:1.4em}.ds-warn{border-color:var(--err);color:var(--err)}"
    },
    {
      "name": "Stage Chips",
      "kind": "chip",
      "refersTo": "badge",
      "description": "Lesson stage progress: done (green), current (blue outline), upcoming.",
      "html": "<div class=\"ds-stages\"><span class=\"done\">Meet the keys</span><span class=\"on\">Mixed drill</span><span>Words</span><span>Sentences</span></div>",
      "css": ".ds-stages{font-family:var(--body);display:flex;gap:6px;flex-wrap:wrap}.ds-stages span{font-size:12px;padding:3px 10px;border-radius:99px;border:1px solid var(--line);color:var(--muted)}.ds-stages span.on{border-color:var(--accent);color:var(--accent);font-weight:700}.ds-stages span.done{background:var(--ok);border-color:var(--ok);color:#fff}"
    },
    {
      "name": "Lesson Row",
      "kind": "card",
      "refersTo": "card",
      "description": "Lesson list item; the next lesson gets the amber border and lift.",
      "html": "<div class=\"ds-lesson ds-next\"><span class=\"ds-num\">3</span><div class=\"ds-ttl\"><b>New keys <span class=\"ds-kc\">t</span><span class=\"ds-kc\">n</span></b><span class=\"ds-meta\"><span class=\"ds-stars\"><i class=\"on\">★</i><i class=\"on\">★</i><i>★</i></span>4 stages</span></div><button class=\"ds-btn-go\">Start</button></div>",
      "css": ".ds-lesson{font-family:var(--body);display:grid;grid-template-columns:40px minmax(0,1fr) auto;gap:14px;align-items:center;background:var(--surface);color:var(--ink);border:1px solid var(--line);border-radius:12px;padding:12px 14px}.ds-next{border-color:var(--go);box-shadow:var(--shadow)}.ds-num{width:34px;height:34px;border-radius:50%;border:2px solid var(--line);display:grid;place-items:center;font-weight:700;font-variant-numeric:tabular-nums;font-size:14px}.ds-ttl{display:flex;flex-direction:column;gap:6px}.ds-ttl b{font-size:17px;display:flex;gap:6px;align-items:center}.ds-meta{display:flex;gap:12px;font-size:13px;color:var(--muted)}.ds-stars i{font-style:normal;color:var(--line)}.ds-stars i.on{color:var(--go)}.ds-kc{display:inline-flex;align-items:center;justify-content:center;min-width:1.9em;height:1.9em;padding:0 .4em;border:1px solid var(--key-edge);border-bottom-width:3px;border-radius:6px;background:var(--key);color:var(--key-ink);font-family:var(--mono);font-weight:600;font-size:.86em}.ds-btn-go{font:inherit;border:1px solid var(--go);background:var(--go);color:var(--go-ink);border-radius:8px;padding:8px 16px;font-weight:700;cursor:pointer}.ds-btn-go:hover{filter:brightness(1.05)}.ds-btn-go:focus-visible{outline:2px solid var(--accent);outline-offset:2px}"
    },
    {
      "name": "Drill Viewport",
      "kind": "custom",
      "description": "Mono typing line: typed, missed, current and upcoming characters.",
      "html": "<div class=\"ds-typebox\"><span class=\"ok\">the</span><span class=\"ok\"> </span><span class=\"bad\">r</span><span class=\"ok\">at</span><span class=\"cur\">e</span><span> is right</span></div>",
      "css": ".ds-typebox{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:22px 26px;box-shadow:var(--shadow);font-family:var(--mono);font-size:24px;line-height:1.9em;color:var(--muted)}.ds-typebox span{border-radius:3px}.ds-typebox .ok{color:var(--ink);opacity:.45}.ds-typebox .bad{color:var(--err);background:var(--err-soft)}.ds-typebox .cur{color:var(--ink);background:var(--accent-soft);box-shadow:inset 0 -3px 0 var(--accent)}"
    }
  ],
  "narrative": {
    "northStar": "The Keycap Workbench",
    "overview": "The app is a calm workbench, and the user's own keyboard is the object on it. The ground is a cool, slightly blue-grey desk. White cards sit on it with hairline borders, and the drill text and the on-screen keyboard are the only things that ask for attention. Visual vocabulary comes from keycaps: mono legends, a thicker bottom edge that reads as a raised cap, and finger colors pastel enough that the legend stays readable.\n\nTwo accents carry all the meaning. Keycap Blue marks where you are: the current view, the cursor, the layer you're holding. Go Amber marks the one thing to do next: the key to press, the lesson to start, the goal ring that is filling up. Everything else is neutral, so the amber stays easy to spot.\n\nDensity is moderate and working-tool-like. Text is plain and set in Atkinson Hyperlegible. Bricolage Grotesque gives headings and numbers a little warmth without turning the app into a game.",
    "keyCharacteristics": [
      "A cool desk-grey ground with flat white cards and 1px borders.",
      "Blue for \"where you are\", amber for \"what's next\", green for \"done\", red for errors (always on a soft red tint).",
      "A keycap motif: mono legends and a 3px bottom edge on key chips.",
      "Finger colors appear only on the keyboard diagram.",
      "Full light and dark themes driven by the same token names."
    ],
    "rules": [
      {
        "name": "The Two Signals Rule",
        "body": "Blue means \"you are here\", amber means \"do this next\". Don't use amber for decoration or as a second brand color. If more than one or two amber things are visible, one of them is wrong.",
        "section": "colors"
      },
      {
        "name": "The Fingers Stay On The Keyboard Rule",
        "body": "Finger colors appear only on the keyboard diagram and its legend. They are never used for UI state.",
        "section": "colors"
      },
      {
        "name": "The Paired Token Rule",
        "body": "Every color token has a light and a dark value under the same name, set in `:root`, the `prefers-color-scheme: dark` block and `[data-theme=\"dark\"]`. A new token needs all three.",
        "section": "colors"
      },
      {
        "name": "The Tabular Numbers Rule",
        "body": "Every number that changes while you type (stats, counts, table cells, lesson numbers) uses `font-variant-numeric: tabular-nums` so it doesn't jitter.",
        "section": "typography"
      },
      {
        "name": "The Mono Means Keys Rule",
        "body": "Plex Mono is for things you type: drill text, key legends, keycap chips, shortcut hints and code. Prose is never set in mono.",
        "section": "typography"
      },
      {
        "name": "The One Lifted Thing Rule",
        "body": "Shadows mark the one place to look: the drill, the next lesson or an open dialog. Cards at rest don't get a shadow.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do route every color through the tokens in `src/style.css`, with a light and a dark value for each.",
      "Do keep amber for the single next action or target, and blue for location and selection.",
      "Do show keys as keycap chips (mono, 3px bottom edge) wherever a key is named in UI text.",
      "Do use tabular figures for every live number.",
      "Do keep cards flat with 1px Line borders, and save the one shadow for what needs attention now.",
      "Do check each screen in light, dark and ≤860px widths, and turn off motion under `prefers-reduced-motion`."
    ],
    "donts": [
      "Don't use finger colors outside the keyboard diagram.",
      "Don't put white text on Go Amber. Use Go Amber Ink.",
      "Don't show errors in red text alone without the soft red tint, and don't make error feedback louder than the existing short shake.",
      "Don't add shadows to resting cards, or gradients or glows anywhere.",
      "Don't set prose in mono, or drill text in the body face."
    ]
  }
}
